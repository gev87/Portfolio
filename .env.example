# OpenRouter — https://openrouter.ai/keys
# Free-tier limits: 20 requests/minute, 50 requests/day.
# A one-time purchase of $10 in credits raises the daily cap to 1,000.
# Models listed below are $0/token either way; credits only lift the cap.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Comma-separated, tried in order — the endpoint falls through to the
# next when one is retired. Free model IDs churn, so this is a config change
# rather than a code edit. Verify current ones:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
